# Optional overrides for the SpacetimeDB connection. Copy to .env.local to use them.
# Defaults when unset:
#   npm run dev    -> ws://localhost:3000, database "coscene"        (local `spacetime start`)
#   npm run build  -> wss://maincloud.spacetimedb.com, "coscene-hackutd"
# VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
# VITE_SPACETIME_DB=coscene-hackutd
